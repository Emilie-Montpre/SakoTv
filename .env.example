EXPO_PUBLIC_TMDB_API_KEY=colle_ta_cle_api_tmdb_ici

# MyAnimeList (myanimelist.net/apiconfig/create) - le secret n'est pas utilise pour les lectures publiques
EXPO_PUBLIC_MAL_CLIENT_ID=colle_ton_client_id_mal_ici
EXPO_PUBLIC_MAL_CLIENT_SECRET=colle_ton_client_secret_mal_ici

# TheTVDB v4 (thetvdb.com) - le PIN n'est necessaire que pour une cle de palier abonne
EXPO_PUBLIC_THETVDB_API_KEY=colle_ta_cle_thetvdb_ici
EXPO_PUBLIC_THETVDB_PIN=

# OMDb (omdbapi.com/apikey.aspx)
EXPO_PUBLIC_OMDB_API_KEY=colle_ta_cle_omdb_ici

# Streaming Availability via RapidAPI (movieofthenight.com)
EXPO_PUBLIC_STREAMING_AVAILABILITY_API_KEY=colle_ta_cle_rapidapi_ici
